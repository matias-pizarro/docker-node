FROM ghcr.io/matias-pizarro/freebsd-oci-containers/freebsd-zfs:{{ freebsd_version }}

RUN echo "node:1000:::0:0:Node user:/home/node:/usr/local/bin/bash:" | adduser -f -

RUN /usr/bin/env pkg install -yr FreeBSD \
    brotli \
    c-ares \
    ca_root_nss \
    gmake \
    icu \
    libffi \
    libnghttp2 \
    libnghttp3 \
    libngtcp2 \
    libuv \
    mpdecimal \
    python311 \
    readline \
    simdjson \
    && rm -f /var/cache/pkg/*

{{ install_archivers_line_1 }}
{{ install_archivers_line_2 }}

ENV NODE_VERSION=0.0.0

RUN /usr/bin/env pkg install -yr FreeBSD www/node{{ node_version }} \
    www/npm-node{{ node_version }} \
    && ln -s /usr/local/bin/node /usr/local/bin/nodejs \
    # smoke tests
    && node --version \
    && npm --version \
    && rm -f /var/cache/pkg/*

ENV YARN_VERSION=0.0.0

RUN /usr/bin/env pkg install -yr FreeBSD www/yarn-node{{ node_version }} \
    # smoke test
    && yarn --version \
    && rm -f /var/cache/pkg/*

COPY --chmod=755 docker-entrypoint.sh /usr/local/bin/
ENTRYPOINT ["docker-entrypoint.sh"]

CMD [ "node" ]
